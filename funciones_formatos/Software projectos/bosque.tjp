#Tareas
/* 
 * ================================
 * PRECONTRACTUAL
 * ================================
 */

task t0 "Contratacion " {
  chargeset productCost
  task t0a "Pliegos SECOP II" {
      length 2m
      journalentry %{${now} + 2w} "Convocatoria Publica y Seleccion" {
        summary -8<-
          Resumen del issuue.
        ->8-
        details -8<-
          Detalle del issuue.
        ->8- 
        }
      }
  task t0a1 "Acta de Inicio" {
      milestone
      depends !t0a
      journalentry %{${now} + 2m} "Convocatoria Publica y Seleccion" {
        summary -8<-
          Resumen del issuue.
        ->8-
        details -8<-
          Detalle del issuue.
        ->8- 
        }

    }
  }



/* 
 * ================================
 * Objetivo 1. IMPLEMENTAR SISTEMAS PARA EL MANEJO SOSTENIBLE DE LOS ECOSISTEMAS FORESTALES 
 * ================================
 */
task t1 "Sistemas de Manejo Forestal " {
  chargeset productCost

/* 
 * ================================
 * Objetivo 1a. Gestion Ecositemica
 * ================================
 */



  task t1a "Manejo de Paisaje" {
      depends t0.t0a1
      #milestone  
 
    task t1c "Capacitacion" {
              #depends !t1a
              effort 2m
              allocate antro1

    }

    task t1a1 "Establecimiento" {
            effort 2m
            depends !t1c
            allocate bio1
            charge 61740860 onstart #onend 
             limits {
                   weeklymax 4d
                      }
           }
    
    task t1a2 "Mantenimiento" {
      depends !t1a1
       task t1a21 "Primer Mantenimiento"{
                  #depends !t1a2 {gapduration 3m}
                 ##minstar %{${now} + 5m}
                  effort 1m
                  allocate camp1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                      }

       task t1a22 "Segundo Mantenimiento"{
                  depends !t1a21 {gapduration 3m}
                # #minstar %{${now} + 8m}
                  effort 1m
                  allocate camp1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                       }
                
                 task t1a23 "Tercer Mantenimiento"{
                  depends !t1a22 {gapduration 3m}
                 # #minstar %{${now} + 12m}
                  effort 1m
                  allocate camp1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                       }
              }

    task t1a3 "Seguimiento" {
       depends !t1a1 #{gapduration 3m}
       task t1a31 "Primer Seguimiento"{
                  #depends !t1a1 {gapduration 3m}
                  #minstar %{${now} + 5m}
                  effort 1m
                  allocate bio1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                      }

       task t1a32 "Segundo Seguimiento"{
                  depends !t1a31 {gapduration 3m}
                  effort 1m
                  #minstar %{${now} + 8m}
                  allocate bio1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                       }
                 
                 task t1a33 "Tercer Seguimiento"{
                  depends !t1a32 {gapduration 3m}
                  effort 1m
                  #minstar %{${now} + 12m}
                  allocate bio1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                       }
             }
    

/* 
 * ================================
 * Objetivo 1b. Agricultura
 * ================================
 */

  task t1b "Sistemas Agroecologicos Multifuncionales" {
      #depends !t1a
     # milestone  
    
    task t1b1 "Establecimiento" {
            effort 2m
            #depends !t1a
            allocate etno1
            charge 61740860 onstart #onend 
             limits {
                   weeklymax 4d
                      }
           }
    
    task t1b2 "Mantenimiento" {
      depends !t1b1 {gapduration 3m}
       task t1b21 "Primer Mantenimiento"{
                  #depends {gapduration 3m} #{minstar %{${now} + 5m}}
                  effort 1m
                  allocate camp1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                      }

       task t1b22 "Segundo Mantenimiento"{
                  depends !t1b21 {gapduration 3m}
                  #minstar %{${now} + 8m}
                  effort 1m
                  allocate camp1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                       }
                
                 task t1b23 "Tercer Mantenimiento"{
                  depends !t1b22 {gapduration 3m}
                  #minstar %{${now} + 12m}
                  effort 1m
                  allocate camp1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                       }
              }

    task t1b3 "Seguimiento" {
       depends !t1b1
       
       task t1b31 "Primer Seguimiento"{
                  #depends !t1b1 {gapduration 3m}
                  #minstar %{${now} + 5m}
                  effort 1m
                  allocate etno1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                      }

       task t1b32 "Segundo Seguimiento"{
                  depends !t1b31 {gapduration 3m}
                  #minstar %{${now} + 8m}
                  effort 1m
                  allocate etno1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                       }
                 
                 task t1b33 "Tercer Seguimiento"{
                  depends !t1b32 {gapduration 3m}
                  #minstar %{${now} + 12m}
                  effort 1m
                  allocate etno1
                  charge 6174086 onstart #onend 
                   limits {
                         weeklymax 4d
                            }
                       }
             }
      }
   
/* 
 * ================================
 * Objetivo 1d. Monitoreo
 * ================================
 */

   task t1d "Monitoreo" {
                  depends !t1c {gapduration 3m}
                  task t1d1 "Primer Monitoreo"{
                       #depends !t1c 
                       #minstar %{${now} + 2m}
                       effort 1m
                       allocate bio1
                       charge 6174086 onstart #onend 
                        limits {
                              weeklymax 4d
                                 }                  
                  }
   

                  task t1d2 "Segundo Monitoreo"{
                       depends !t1d1{gapduration 3m} #!t1a1, !t1b1 
                       #minstar %{${now} + 5m}
                       effort 1m
                       allocate bio1
                       charge 6174086 onstart #onend 
                        limits {
                              weeklymax 4d
                                 }                  
                  }

                  task t1d3 "Tercer Monitoreo"{
                       depends !t1d2{gapduration 3m} #!t1a2, !t1b2 
                       #minstar %{${now} + 8m}
                       effort 1m
                       allocate bio1
                       charge 6174086 onstart #onend 
                        limits {
                              weeklymax 4d
                                 }                  
                  }

                  task t1d4 "Cuarto Monitoreo"{
                       depends !t1d3{gapduration 3m} #!t1a3, !t1b3 
                       #minstar %{${now} + 12m}
                       effort 1m
                       allocate bio1
                       charge 6174086 onstart #onend 
                        limits {
                              weeklymax 4d
                                 }                  
                  }
          }

/* 
 * ================================
 * Objetivo 1e. Asistencia Tecnica
 * ================================
 */

   task t1e "Asistencia Tecnica" {
                  depends !t1c {gapduration 3m}
                  task t1e1 "Primera Asistencia Tecnica"{
                       #depends !t1c 
                       #minstar %{${now} + 2m}
                       effort 1m
                       allocate etno1
                       charge 6174086 onstart #onend 
                        limits {
                              weeklymax 4d
                                 }                  
                  }
   

                  task t1e2 "Segunda Asistencia Tecnic"{
                       depends !t1e1 {gapduration 3m}#!t1a1, !t1b1 
                       #minstar %{${now} + 5m}
                       effort 1m
                       allocate etno1
                       charge 6174086 onstart #onend 
                        limits {
                              weeklymax 4d
                                 }                  
                  }

                  task t1e3 "Tercera Asistencia Tecnica"{
                       depends !t1e2 {gapduration 3m} #!t1a2, !t1b2 
                       #minstar %{${now} + 8m}
                       effort 1m
                       allocate etno1
                       charge 6174086 onstart #onend 
                        limits {
                              weeklymax 4d
                                 }                  
                  }

                  task t1e4 "Cuarta Asistencia Tecnica"{
                       depends !t1e3 {gapduration 3m} #!t1a3, !t1b3 
                       #minstar %{${now} + 12m}
                       effort 1m
                       allocate etno1
                       charge 6174086 onstart #onend 
                        limits {
                              weeklymax 4d
                                 }                  
                  }
          }
   }
}
/* 
 * ================================
 * GENERACIÓN DE REPORTES
 * ================================
 */

taskreport "Cronogramabosque1" {
  formats html
    header -8<-
    === Resumen del Proyecto ===

    Este proyecto se estructura en 3 actividades grandes.

    # Implementar sistemas para el manejo sostenible de los ecosistemas forestales 
    # Promover actividades turísticas que protejan las coberturas naturales
    # Fortalecer la gobernanza ambiental frente al uso y manejo de las coberturas naturales

    === Plan Original del Proyecto ===
  ->8-
  headline "Cronograma del Proyecto" 
  caption "Este es el desglose de actividades"
  columns bsi {title 'EDA'},
          name { 
            title 'Nombre'
            fontcolor @ all '#5F9EA0'
            cellcolor @ all '#F0FFFF'
          }, start {title 'Inicio'}, end {title 'Fin'}, effort {title 'Esfuerzo'}, pathcriticalness {width 2}, cost {title 'Costo'}, chart { ${TaskTip} }
          sorttasks tree #plan.start.up #tree
  #balance cost rev
  footer -8<-
    === Curiosidades ===
    Se esta usando [[Taskjuggler]] para realizar el cronograma

    === Convocatoria Ambiental ===

    Se debe tener un claro el calendario, el presupuesto y el uso de la plataforma del GESPROY.
 
  ->8-
 #sorttasks tree #tree #start.up  #plan.end.down #id.up
 #fontcolor isvalid(plan.maxend) & (plan.end > plan.maxend)

  }


resourcereport "Asignacionesbosque1" {
  formats html
  headline "Talento Humano"
  columns name {title 'Nombre'}, rate {title 'Tasa'}, effort {title 'Esfuerzo'}, effortdone {title 'Realizado'}, effortleft  {title 'Falta'}
}


accountreport "PTrimestrebosque1" {
  formats html
  accountroot cost
  balance -
  columns no, name {title 'Nombre'}, quarterly {title 'Cuatrimestre' celltext 1 "<-query attribute='turnover'->" }
}


accountreport "Reporte de Cuentas bosque1" {
  formats html
  columns no, name {title 'Nombre'}, monthly
}

tracereport "TraceReportbosque" {
  columns end { title "<-name->" }
  hidetask 0
}

textreport frame "textreportbosque" {
  taskreport r1 ""
  taskreport r2 ""

  formats html
  header -8<-
  This is the header
  ----
  ->8-
  left "<[report id='frame.r1']>"
  center "Center"
  right "<[report id='frame.r2']>"
  footer -8<-
  ----
  This is the footer
  ->8-
}

taskreport breakdown "EsfuerzoporActividad" {
  formats html
  caption "Este es el desglose de Actividades"
  headline "Desglose del Proyecto"
  header -8<-
  Aqui estan las actividades asi como el esfuerzo requerido por cada persona del equipo para realizarla
  ----
  ->8-
  left "<[report id='frame.r1']>"
  center "Center"
  right "<[report id='frame.r2']>"
  footer -8<-
  ----
  Esta herramienta nos permite analizar los momentos de mayor esfuerzo en el proyecto
  ->8-
  columns no, name {title 'Nombre'}, start {title 'Inicio'}, end {title 'Final'}, duration {title 'Duracion'}, monthly
  # Don't hide any resource, meaning show them all.
  hideresource 0
}