from qgis.core import QgsProject, QgsVectorLayer, QgsFeature, QgsGeometry, QgsPointXY, QgsField
from PyQt5.QtCore import QVariant

# Datos de coordenadas
datos = [
    ["Raposo", "Las Cruces", "10-1", 3.685489, -77.144661],
    ["Raposo", "Las Cruces", "10-2", 3.686576, -77.144123],
    ["Raposo", "Las Cruces", "9-1", 3.68796, -77.144128],
    ["Raposo", "Las Cruces", "9-2", 3.687961, -77.144184],
    ["Raposo", "Las Cruces", "8-1", 3.6881, -77.142932],
    ["Raposo", "Las Cruces", "8-2", 3.688, -77.142861],
    ["Raposo", "Las Cruces", "7-1", 3.688245, -77.142013],
    ["Raposo", "Las Cruces", "7-2", 3.688263, -77.141952],
    ["Raposo", "Las Cruces", "6-1", 3.694935, -77.138652],
    ["Raposo", "Las Cruces", "6-2", 3.694934, -77.138643],
    ["Raposo", "Las Cruces", "5-1", 3.693342, -77.140188],
    ["Raposo", "Las Cruces", "4-1", 3.693331, -77.140146],
    ["Raposo", "Las Cruces", "4-2", 3.692492, -77.140827],
    ["Raposo", "Las Cruces", "3-1", 3.691563, -77.141505],
    ["Raposo", "Las Cruces", "3-2", 3.691549, -77.141465],
    ["Raposo", "Las Cruces", "2-1", 3.69056, -77.141733],
    ["Raposo", "Las Cruces", "2-2", 3.690565, -77.141662],
