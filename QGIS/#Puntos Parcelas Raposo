    ["Yurumangui", "", "", 3.377352, -77.378033],
    ["Yurumangui", "", "", 3.37748, -77.378297]
]

# Crear capa de puntos en memoria (EPSG:4326 - WGS84)
capa = QgsVectorLayer("Point?crs=EPSG:4326", "Parcelas Raposo y Yurumangui", "memory")
proveedor = capa.dataProvider()

# Agregar campos/atributos
proveedor.addAttributes([
    QgsField("Consejo", QVariant.String),
    QgsField("Vereda", QVariant.String),
    QgsField("Parcela", QVariant.String),
    QgsField("Latitud", QVariant.Double),
    QgsField("Longitud", QVariant.Double)
])
capa.updateFields()

# Crear features y agregarlos
features = []
for dato in datos:
    feature = QgsFeature()
    # Crear geometría de punto (Longitud, Latitud)
    punto = QgsPointXY(dato[4], dato[3])
    feature.setGeometry(QgsGeometry.fromPointXY(punto))
    # Agregar atributos
    feature.setAttributes([
        dato[0],  # Consejo
        dato[1],  # Vereda
        dato[2],  # Parcela
        dato[3],  # Latitud
        dato[4]   # Longitud
    ])
    features.append(feature)

# Agregar features a la capa
proveedor.addFeatures(features)
capa.updateExtents()

# Agregar al proyecto
QgsProject.instance().addMapLayer(capa)

print(f"✅ Se agregaron {len(features)} puntos exitosamente")
print(f"📍 Capa: {capa.name()}")