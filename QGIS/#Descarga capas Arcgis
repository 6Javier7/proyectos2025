def cargar_desde_url_completa(url_completa, nombre_personalizado=None):
    """
    Carga una capa desde una URL completa de ArcGIS
    Ejemplo: https://services6.arcgis.com/.../FeatureServer/0
    """
    
    print("=" * 70)
    print("🔗 CARGANDO DESDE URL COMPLETA")
    print("=" * 70)
    
    # Extraer URL base y ID de capa
    if '/FeatureServer/' in url_completa:
        partes = url_completa.split('/FeatureServer/')
        if len(partes) == 2:
            url_base = partes[0] + '/FeatureServer'
            try:
                id_capa = int(partes[1].split('/')[0])
                print(f"📦 URL base: {url_base}")
                print(f"🎯 Capa ID: {id_capa}")
                
                return descargar_capa_arcgis(
                    url_base, 
                    id_capa, 
                    nombre_personalizado
                )
            except:
                pass
    
    # Si no se pudo parsear, usar la URL completa
    print("⚠️ No se pudo parsear la URL, intentando con URL completa...")
    
    # Intentar extraer ID de otra forma
    try:
        # Buscar el último número en la URL
        import re
        numeros = re.findall(r'/(\d+)$', url_completa)
        if numeros:
            id_capa = int(numeros[0])
            url_base = url_completa.rsplit('/', 1)[0]
            
            return descargar_capa_arcgis(
                url_base, 
                id_capa, 
                nombre_personalizado
            )
    except:
        pass
    
    # Último intento: usar como está
    return descargar_capa_arcgis(
        url_completa, 
        id_capa=0, 
        nombre_personalizado=nombre_personalizado
    )




