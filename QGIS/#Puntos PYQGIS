from qgis.core import QgsCategorizedSymbolRenderer

# Colores para más zonas (incluyendo las nuevas)
colores_zonas = {
    1: QColor("red"),
    2: QColor("blue"),
    3: QColor("green"),
    4: QColor("purple"),
    5: QColor("orange"),
    10: QColor("darkred"),
    11: QColor("darkblue"),
    12: QColor("darkgreen"),
    13: QColor("cadetblue"),
    88: QColor("gray"),
    99: QColor("black")
}

# Crear categorías
categories = []
for zona, color in colores_zonas.items():
    # Crear símbolo para cada zona
    symbol = QgsMarkerSymbol.createSimple({
        'name': 'circle',
        'color': color.name(),
        'size': '5',
        'outline_color': 'white',
        'outline_width': '0.5'
    })
    categories.append(QgsRendererCategory(zona, symbol, f"Zona {zona}"))

# Aplicar renderizador categorizado
renderer = QgsCategorizedSymbolRenderer("Zona", categories)
layer.setRenderer(renderer)

