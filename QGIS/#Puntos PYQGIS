    id_punto = int(fila[0])
    depto = str(fila[1])
    muni = str(fila[2])
    lat = float(fila[3])   # ¡CONVERTIR A FLOAT!
    lon = float(fila[4])   # ¡CONVERTIR A FLOAT!
    zona = int(fila[5])
    
    # Crear feature
    feat = QgsFeature()
    # QgsPointXY espera números, no strings
    feat.setGeometry(QgsGeometry.fromPointXY(QgsPointXY(lon, lat)))
    # Incluir todos los campos, incluyendo lat/lon
    feat.setAttributes([id_punto, depto, muni, lat, lon, zona])
    features.append(feat)

# Añadir todos los features de una vez
provider.addFeatures(features)
layer.updateExtents()

