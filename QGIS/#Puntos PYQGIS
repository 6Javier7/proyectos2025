# Coordenadas UTM 18N
este = 641929.58
norte = 964211.17

# 1. Crear capa de puntos con CRS UTM 18N
capa = QgsVectorLayer("Point?crs=EPSG:32618", "Punto UTM 18N", "memory")

# 2. Configurar proveedor
provider = capa.dataProvider()
provider.addAttributes([
    QgsField("id", QVariant.Int),
    QgsField("nombre", QVariant.String),
    QgsField("este", QVariant.Double),
    QgsField("norte", QVariant.Double)
])
capa.updateFields()

# 3. Crear feature
feat = QgsFeature()
# Crear geometría en UTM 18N
feat.setGeometry(QgsGeometry.fromPointXY(QgsPointXY(este, norte)))
feat.setAttributes([1, "Mi Punto UTM", este, norte])

# 4. Añadir a capa
provider.addFeatures([feat])

# 5. Añadir al proyecto
QgsProject.instance().addMapLayer(capa)

print(f"✅ Punto UTM creado: {este}, {norte}")
print(f"   CRS: UTM 18N (EPSG:32618)")



