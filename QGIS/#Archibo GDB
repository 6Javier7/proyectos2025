from qgis.core import QgsVectorLayer, QgsProject

# Ruta a la carpeta .gdb
gdb_path = "/Volumes/Compartidx/proyectos/tu_carpeta.gdb"

# Nombre exacto de la capa dentro de la GDB
nombre_capa = "nombre_de_la_capa"  # Ej: "limites", "rios", "poligonos"

# Construir la URI correcta
uri = f"{gdb_path}|layername={nombre_capa}"

# Cargar la capa
capa = QgsVectorLayer(uri, nombre_capa, "ogr")

if capa.isValid():
    QgsProject.instance().addMapLayer(capa)
    print(f"✅ Capa '{nombre_capa}' cargada exitosamente")
else:
    print(f"❌ Error al cargar la capa. Verifica el nombre exacto")