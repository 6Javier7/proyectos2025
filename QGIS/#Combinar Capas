}

output_path = '/Users/javiermontanochiriboga/Documents/Javier/Proyectos/Ambiente/POMCAS/POMCAS Zonificacion/Faltantes/ZonificacionPomcas.gpkg'

# Lista para almacenar capas válidas
capas_validas = []

print("="*60)
print("🔍 VERIFICANDO CAPAS")
print("="*60)

for nombre, ruta in rutas.items():
    print(f"\n📂 {nombre}:")
    print(f"   {ruta}")
    
    # Cargar capa
    capa = QgsVectorLayer(ruta, nombre, "ogr")
    
    if not capa.isValid():
        print(f"   ❌ No se pudo cargar la capa")
        continue
    
    # Verificar tipo de geometría
    geom_type = capa.geometryType()
    wkb_type = capa.wkbType()
    
    print(f"   ✅ Features: {capa.featureCount()}")
    print(f"   📐 WKB Type: {wkb_type}")
    
    # 0=Punto, 1=Línea, 2=Polígono
    if geom_type == 2:
        print(f"   ✅ GEOMETRÍA CORRECTA: Polígonos")
        capas_validas.append(capa)
        QgsProject.instance().addMapLayer(capa)
    elif geom_type == 1:
        print(f"   ❌ ERROR: Es una capa de LÍNEAS, se necesitan POLÍGONOS")
    elif geom_type == 0:
        print(f"   ❌ ERROR: Es una capa de PUNTOS, se necesitan POLÍGONOS")
    else:
        print(f"   ❌ ERROR: Tipo de geometría desconocido o inválido")
        
        # Intentar reparar geometría
        print(f"   🔧 Intentando reparar geometría...")
        try:
            reparada = processing.run("native:fixgeometries", {
                'INPUT': capa,
                'OUTPUT': 'memory:'
            })['OUTPUT']
            
            if reparada.geometryType() == 2:
                print(f"      ✅ Reparada exitosamente - Ahora es polígono")
                capas_validas.append(reparada)
                QgsProject.instance().addMapLayer(reparada)
            else:
                print(f"      ❌ No se pudo reparar")
        except Exception as e:
            print(f"      ❌ Error reparando: {e}")

print("\n" + "="*60)
print(f"📊 CAPAS VÁLIDAS PARA COMBINAR: {len(capas_validas)} de {len(rutas)}")
print("="*60)

