from qgis.core import QgsProject, QgsVectorLayer, QgsFeature

# ============================================
# CAMBIAR VALORES USANDO EXPRESIONES
# ============================================

capa = QgsProject.instance().mapLayersByName('ZonificacionPomcas')[0]

# DICCIONARIO DE REEMPLAZOS
# Formato: 'valor_actual': 'nuevo_valor'
reemplazos = {
    '01': 'Áreas del SINAP',
    '02': 'Áreas complementarias a la conservación',
    '03': 'Áreas de importancia ambiental',
    '04': 'Áreas con reglamentación especial',
    '05': 'Áreas de amenazas naturales',
    '06': 'Áreas de restauración ecológica',
    '07': 'Áreas de rehabilitación',
    '08': 'Áreas de recuperación para el uso múltiple',
    '09': 'Áreas agrícolas',
    '10': 'Áreas agrosilvopastoriles',
    '11': 'Áreas urbanas municipales y distritales',
    '12': 'Áreas objeto de ajuste cartográfico',
    '13': 'Otras subzonas de uso y manejo'
}

print("🔄 Reemplazando valores en campo 'szon_uso_m'...")

capa.startEditing()
contador = 0

for feature in capa.getFeatures():
    valor_actual = str(feature['szon_uso_m'])
    
    if valor_actual in reemplazos:
        nuevo_valor = reemplazos[valor_actual]
        feature['szon_uso_m'] = nuevo_valor
        capa.updateFeature(feature)
        contador += 1
        print(f"   ✓ {valor_actual} → {nuevo_valor}")

capa.commitChanges()
print(f"\n✅ {contador} valores reemplazados exitosamente")